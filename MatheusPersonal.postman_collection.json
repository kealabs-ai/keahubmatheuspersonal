        {
          "name": "Update Transaction ID",
          "request": {
            "method": "POST",
            "url": "{{payments_url}}/payments/1/update-transaction?transaction_id=TXN_REAL_456"
          }
        },
        {
          "name": "Get Order Payments",
          "request": {
            "method": "GET",
            "url": "{{payments_url}}/payments/order/1"
          }
        },
        {
          "name": "Webhook InfinitePay",
          "request": {
            "method": "POST",
            "url": "{{payments_url}}/payments/webhook/infinitepay",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.approved\",\n  \"id\": \"TXN_ABC123\",\n  \"status\": \"approved\",\n  \"amount\": 9990,\n  \"payment_method\": \"credit_card\"\n}"
            }
          }
        }
      ]
    },
